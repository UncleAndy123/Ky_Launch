<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Big clock + date, right-aligned. Every line is single-line and auto-sizes
         so it never wraps, regardless of screen width / aspect ratio. -->
    <LinearLayout
        android:id="@+id/clock_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:autoSizeMaxTextSize="76sp"
                app:autoSizeMinTextSize="34sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="@color/kai_text"
                android:textSize="76sp" />

            <TextView
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:singleLine="true"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="@color/kai_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            android:gravity="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/kai_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            android:gravity="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/kai_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Big notification banner: replaces the old small icon+count badges with a
         bold, hard-to-miss bar showing the most recent active call/message/other
         notification. Purely passive - this hardware has no touchscreen and every
         D-pad/soft key is already claimed as a user-assignable shortcut, so the
         bar is never focusable or tappable (see MainActivity.updateNotifBanner). -->
    <LinearLayout
        android:id="@+id/notif_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_notif_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clock_column">

        <ImageView
            android:id="@+id/notif_banner_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_banner_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/flipOnAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/flipOnAccent"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Soft keys over the wallpaper: Notices | D-pad pod (with the App-Drawer/OK
         button in its center) | Contacts. The pod's four directional icons are
         independently shown/hidden as each direction is assigned/cleared; the
         pod itself (and its center OK button) always stays visible. -->
    <LinearLayout
        android:id="@+id/home_softkeys"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            tools:ignore="RtlSymmetry"
            xmlns:tools="http://schemas.android.com/tools">

            <ImageView
                android:id="@+id/softkey_left_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/softkey_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="2"
                android:shadowColor="#A6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:text="@string/softkey_notifications"
                android:textColor="@color/kai_text"
                android:textSize="@dimen/softkey_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dpad_pod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_dpad_pod"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/dpad_icon_up"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dpad_icon_left"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/softkey_center"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_rail_focus"
                    android:clickable="true"
                    android:contentDescription="@string/content_apps"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_apps_dots" />

                <ImageView
                    android:id="@+id/dpad_icon_right"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dpad_icon_down"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/softkey_right_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/softkey_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="end"
                android:maxLines="2"
                android:shadowColor="#A6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:text="@string/softkey_contacts"
                android:textColor="@color/kai_text"
                android:textSize="@dimen/softkey_text" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
