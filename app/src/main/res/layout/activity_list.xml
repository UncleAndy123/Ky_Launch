<?xml version="1.0" encoding="utf-8"?>
<!-- Shared layout for the Options / Hide Apps / Shortcuts / App Picker screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/flipSoftkeyBg"
        android:gravity="center"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Flip.ScreenTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Centered placeholder shown by screens (e.g. Notices) when the list is
             empty; every other screen simply leaves it GONE. -->
        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="?attr/flipTextSecondary"
            android:textSize="@dimen/softkey_text"
            android:visibility="gone" />
    </FrameLayout>

    <com.flipos.launcher.ui.SoftKeyBar
        android:id="@+id/soft_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
