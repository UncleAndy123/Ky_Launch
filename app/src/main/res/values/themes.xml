<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark KaiOS-style theme used by settings/drawer screens. The
         flip* items declare this theme's neutral palette as custom
         attributes (see attrs.xml) so shared layouts/drawables/color
         selectors can resolve differently per activity instead of always
         pointing at a literal dark color - see Theme.FlipLauncher.Light
         below, which overrides only these six. -->
    <style name="Theme.FlipLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="flipBg">@color/kai_bg</item>
        <item name="flipSoftkeyBg">@color/kai_softkey_bg</item>
        <item name="flipText">@color/kai_text</item>
        <item name="flipTextSecondary">@color/kai_text_secondary</item>
        <item name="flipDivider">@color/kai_divider</item>
        <item name="flipOnAccent">@color/kai_on_accent</item>
        <item name="android:windowBackground">@color/kai_bg</item>
        <item name="android:colorBackground">@color/kai_bg</item>
        <item name="android:statusBarColor">@color/kai_softkey_bg</item>
        <item name="android:navigationBarColor">@color/kai_softkey_bg</item>
        <item name="colorAccent">@color/kai_accent</item>
        <item name="android:textColorPrimary">@color/kai_text</item>
        <item name="android:textColorSecondary">@color/kai_text_secondary</item>
        <item name="android:windowAnimationStyle">@style/Animation.Flip.Activity</item>
    </style>

    <!-- Light counterpart of Theme.FlipLauncher, applied via Activity.setTheme()
         (not a runtime overlay - see LauncherPrefs.ThemeMode) so the
         AppCompat.Light family itself is what's active, not just a few
         attributes layered on the dark family. That's what makes AlertDialog's
         own default chrome (background, buttons) render light too, not just
         the content this app draws itself. Only applied to the "flat" list/
         settings screens (BaseListActivity, IconPickerActivity) - Home and the
         App Drawer always stay on the dark Theme.FlipLauncher.Home/.Drawer,
         since their wallpaper scrim is about legibility over an arbitrary
         photo, not a light/dark palette choice. -->
    <style name="Theme.FlipLauncher.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="flipBg">@color/kai_bg_light</item>
        <item name="flipSoftkeyBg">@color/kai_softkey_bg_light</item>
        <item name="flipText">@color/kai_text_light</item>
        <item name="flipTextSecondary">@color/kai_text_secondary_light</item>
        <item name="flipDivider">@color/kai_divider_light</item>
        <item name="flipOnAccent">@color/kai_on_accent</item>
        <item name="android:windowBackground">@color/kai_bg_light</item>
        <item name="android:colorBackground">@color/kai_bg_light</item>
        <item name="android:statusBarColor">@color/kai_softkey_bg_light</item>
        <item name="android:navigationBarColor">@color/kai_softkey_bg_light</item>
        <item name="colorAccent">@color/kai_accent</item>
        <item name="android:textColorPrimary">@color/kai_text_light</item>
        <item name="android:textColorSecondary">@color/kai_text_secondary_light</item>
        <item name="android:windowAnimationStyle">@style/Animation.Flip.Activity</item>
    </style>

    <!-- Fast cross-fade for activity open/close. Alpha-only and short so it stays
         smooth on low-end feature-phone chipsets. -->
    <style name="Animation.Flip.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Applied at onCreate when the user disables animations, so navigation is
         instant and free of any transition cost. -->
    <style name="ThemeOverlay.FlipLauncher.NoAnimations" parent="">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Home screen: show the user's wallpaper behind the clock & shortcuts.
         The scrim lives on the window background (not the content view) so it
         extends behind the status bar instead of being clipped by
         fitsSystemWindows, keeping the status bar's darkening consistent with
         the rest of the screen. -->
    <style name="Theme.FlipLauncher.Home" parent="Theme.FlipLauncher">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@drawable/bg_home_scrim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- App drawer: wallpaper behind a translucent black scrim, edge to edge,
         matching the rest of the KaiOS chrome instead of a solid bar. -->
    <style name="Theme.FlipLauncher.Drawer" parent="Theme.FlipLauncher.Home">
        <item name="android:windowBackground">@color/kai_overlay</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Accent color overlays applied at runtime (see LauncherPrefs.AccentColor)
         on top of whichever base theme an activity already uses, so every
         ?attr/colorAccent reference in drawables/layouts follows the user's pick. -->
    <style name="ThemeOverlay.FlipLauncher.Accent.Red" parent="">
        <item name="colorAccent">@color/kai_accent_red</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Orange" parent="">
        <item name="colorAccent">@color/kai_accent_orange</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Yellow" parent="">
        <item name="colorAccent">@color/kai_accent_yellow</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Green" parent="">
        <item name="colorAccent">@color/kai_accent_green</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Blue" parent="">
        <item name="colorAccent">@color/kai_accent_blue</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Indigo" parent="">
        <item name="colorAccent">@color/kai_accent_indigo</item>
    </style>
    <style name="ThemeOverlay.FlipLauncher.Accent.Violet" parent="">
        <item name="colorAccent">@color/kai_accent_violet</item>
    </style>
</resources>
