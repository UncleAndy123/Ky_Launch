<?xml version="1.0" encoding="utf-8"?>
<!-- "On" toggle pill. Accent-filled normally; inverts to a dark pill when the
     row is focused (the focused row itself turns accent) so it stays legible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/flipBg" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/flipBg" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/flipBg" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccent" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>
