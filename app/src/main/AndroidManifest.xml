<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for WallpaperManager.setBitmap() in the bundled Wallpaper Picker. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Places calls directly (speed dial, voicemail key, Recent Calls) via
         Intent.ACTION_CALL. Requested at runtime the first time it's needed,
         never at launch; falls back to ACTION_DIAL if denied. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Reads CallLog.Calls to power the custom Recent Calls screen (Send key).
         Requested at runtime the first time that screen is opened. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Reads the phone's own system speed dial data (content://speed_dial) so
         digit-key speed dial reflects the phone's real assignments instead of a
         separate copy. Requested at runtime the first time it's needed. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      A launcher only needs to see launchable activities and the dialer.
      Using a <queries> block keeps us off the sensitive QUERY_ALL_PACKAGES
      permission while still letting us enumerate every app the user can open.
    -->

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Category-based default-app resolution (Home key/app-grid fallbacks,
             see util/CategoryApps.kt) needs each of these declared explicitly -
             plain package-visibility exemptions don't cover ACTION_MAIN queries
             filtered by an app category. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_FILES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- This Kyocera hardware's own Settings app (see
             util/CategoryApps.kt#systemSettingsPackage, used to seed the app
             grid's "Settings" slot) - explicit insurance for the
             getPackageInfo() visibility check, though it's very likely
             already visible via the generic LAUNCHER query above. -->
        <package android:name="jp.kyocera.settings.nfp" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlipLauncher">

        <!-- Home screen. Registering for CATEGORY_HOME makes this selectable
             as the default launcher. -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FlipLauncher.Home"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Unified settings hub. Exported with a LAUNCHER category so it also
             appears in the app drawer like a regular app for discoverability. -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="true"
            android:icon="@drawable/settings_112"
            android:label="@string/title_settings"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.AppearanceSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.NotificationSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.HomeKeysSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.AppsSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.AppDrawerActivity"
            android:exported="false"
            android:theme="@style/Theme.FlipLauncher.Drawer"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.HideAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.CallLogActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.AppPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.ActivityPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.IconPackActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.IconPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <activity
            android:name=".activities.WallpaperPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize" />

        <!-- Exported with a LAUNCHER category so it also appears in the app
             drawer like a regular app, mirroring SettingsActivity below. -->
        <activity
            android:name=".activities.NoticesActivity"
            android:exported="true"
            android:icon="@drawable/notification_112"
            android:label="@string/softkey_notifications"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|keyboard|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Feeds the Home notification summary (calls/messages/other) and the
             custom Notices screen. Requires the user to grant Notification
             Access in system settings. -->
        <service
            android:name=".service.NotificationCountService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fallback notification source for devices where NotificationListenerService
             access is granted per Settings.Secure but silently never binds (see
             AGENTS.md - confirmed on Kyocera E4810/E4811). Only feeds the Home
             banner; see NotificationAccessibilityService's own doc comment. -->
        <service
            android:name=".service.NotificationAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
